# Base URL of the FastAPI backend. For local development this is:
# http://localhost:8000
VITE_API_BASE_URL=

# Supabase project URL and public anon key (safe to expose to the browser).
# Never put SUPABASE_SERVICE_ROLE_KEY or LIVEKIT_API_SECRET here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true to force demo mode, or false to force real services.
# When unset, demo mode is used unless all three real-service settings above are configured.
VITE_USE_MOCK=

# Quick-login buttons for the demo accounts (backend/scripts/seed_demo.py).
# Set to false to hide them, e.g. in production.
VITE_SHOW_DEMO_ACCOUNTS=
